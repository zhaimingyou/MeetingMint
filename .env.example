# Meeting Minutes Service -- environment template (task 14.4).
# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).
# docker-compose.yml reads this file (env_file) and also overrides REDIS_URL /
# DATABASE_URL / AUDIO_STORAGE_DIR for the compose network.
#
# Production app stack: 192.0.2.10 (DOCKER_PLATFORM=linux/amd64).
# ASR / streaming ASR: 192.0.2.20 (asr-host).

# --- Bootstrap admin (REQUIRED) --------------------------------------------
# The single initial account seeded at startup. Change the password before any
# real deployment; the plaintext is hashed at startup and never persisted.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-deploying

# --- Redis (REQUIRED) ------------------------------------------------------
# Celery broker + result backend + cache. Uses the compose service name.
REDIS_URL=redis://redis:6379/0

# --- Model integration -----------------------------------------------------
# mock = run the whole pipeline with deterministic stand-ins (no models needed).
# Switch to `http` and provide the endpoints to use the real models. With http,
# the endpoint URL(s) + LLM model name become REQUIRED and validated at startup.
ASR_IMPL=mock
LLM_IMPL=mock

# ASR -- local SenseVoice / FunASR (OpenAI-compatible HTTP API). The client
# POSTs to {ASR_ENDPOINT_URL}/v1/audio/transcriptions. ASR_MODEL_NAME defaults
# to "sensevoice".
# ASR_ENDPOINT_URL=http://192.0.2.20:19100
# ASR_MODEL_NAME=sensevoice

# LLM -- any OpenAI-compatible chat endpoint. The client normalizes the base URL
# to {LLM_ENDPOINT_URL}/chat/completions and sends "Authorization: Bearer
# <LLM_API_KEY>" when a key is set (required for hosted providers like DeepSeek;
# omit for a local unauthenticated Ollama / vLLM).
#   DeepSeek (cloud): https://api.deepseek.com + model deepseek-v4-flash (NOTE:
#     this sends transcripts to DeepSeek's servers, outside the internal
#     network). Run `python -m app.diagnostics` to list the models your account
#     actually serves (the legacy deepseek-chat alias may not be listed).
#   Local vLLM/Ollama: http://192.0.2.20:8080/v1 + your served model name.
# LLM_ENDPOINT_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-v4-flash
# LLM_API_KEY=replace-with-your-llm-api-key

# --- Uploads ---------------------------------------------------------------
# Max upload size in bytes (default 500 MB). Keep Nginx client_max_body_size
# (deploy/nginx/nginx.conf) >= this value.
MAX_UPLOAD_BYTES=524288000

# --- Storage (defaults already target the shared /data volume) -------------
DATABASE_URL=sqlite:////data/db/app.db
AUDIO_STORAGE_DIR=/data/audio

# --- Worker tuning (optional) ----------------------------------------------
# Bounded worker concurrency (default 2) and the coarse whole-task hard cap.
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT_SECONDS=3600
